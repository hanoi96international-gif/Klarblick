# ---------- Pflicht im Produktivbetrieb ----------

# Signiert die Sitzungs-Cookies. Ohne echten Zufallswert sind Sitzungen fälschbar.
# Erzeugen mit: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Verschlüsselt die Google-Tokens in der Datenbank (AES-256, also genau 32 Byte
# als Hex = 64 Zeichen). Ohne diesen Schlüssel wäre ein Datenbank-Leak
# gleichbedeutend mit Vollzugriff auf alle verbundenen Google-Business-Profile.
# Erzeugen mit: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# ---------- Google OAuth ----------
# Aus der Google Cloud Console (APIs & Services → Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Muss exakt mit der in der Google Cloud Console hinterlegten Redirect-URI übereinstimmen
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Erst auf true setzen, wenn Google euch für die Business Profile API freigeschaltet hat
# (Antrag über https://developers.google.com/my-business/content/prereqs)
GBP_ACCESS_APPROVED=false

# ---------- AI-Sichtbarkeits-Check ----------
# Schlüssel von console.anthropic.com. Bleibt ausschließlich auf dem Server.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# ---------- Betrieb ----------
PORT=3000
NODE_ENV=development
DATABASE_FILE=./klarblick.db

# Herkünfte, die das Backend aufrufen dürfen (Frontend und Landingpage), kommagetrennt
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Ziel der Weiterleitung nach erfolgreicher Google-Anmeldung
FRONTEND_URL=http://localhost:5173
