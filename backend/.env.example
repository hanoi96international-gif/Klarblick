# Von Google Cloud Console (APIs & Services → Credentials) nach OAuth-Client-Erstellung
GOOGLE_CLIENT_ID=deine-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=dein-client-secret

# Muss exakt mit der in der Google Cloud Console hinterlegten Redirect-URI übereinstimmen
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Zufälligen langen String generieren, z.B. mit: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=aendere-mich-vor-produktivbetrieb

PORT=3000

# Erst relevant, sobald Google euch für die Business Profile API freigeschaltet hat
# (Antrag über: https://developers.google.com/my-business/content/prereqs)
GBP_ACCESS_APPROVED=false
