{
  "name": "klarblick",
  "version": "0.2.0",
  "private": true,
  "description": "Reputations-Monitoring für lokale Unternehmen — Sabotage-Detektor und AI-Sichtbarkeits-Check",
  "type": "module",
  "workspaces": [
    "shared",
    "backend",
    "frontend"
